  <object id="26" template="../../../../common/maps/obj/dialog.tx" x="272" y="112">
   <properties>
    <property name="dialog">[
{
   "text": "«Проклятие безумного шута». Герой по имени Кутуман сочиняет целые миры с пугающей точностью.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null,
      "text": "Переписчик пометил на полях: все исторические лица в рассказе действительно встречались. Откуда шут это знал?",
      "loctext": null,
      "options": [{
         "name": "Дальше",
         "locname": null, "action": [{"deleteMapObject":-1}]}]
      }]
}   
]</property>
   </properties>
  </object>
  <object id="27" template="../../../../common/maps/obj/dialog.tx" x="352" y="112">
   <properties>
    <property name="dialog">[
{
   "text": "Целая куча страниц, выпавших из разных книг. Ни одной зацепки.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null, "action": [{"deleteMapObject":-1}]}]
}
]</property>
   </properties>
  </object>
  <object id="28" template="../../../../common/maps/obj/dialog.tx" x="320" y="200">
   <properties>
    <property name="dialog">[{"text":"«Магическая метеорология», «Разрушительная сила небес». Полка о том, что может свалиться на голову.","loctext":null,"options":[{"name":"Дальше","locname":null,"action":[{"deleteMapObject":-1},{"grantRewards":[{"type":"card","count":1,"cardName":"Bumi Bash|TLA"}]}]}]}]</property>
   </properties>
  </object>
  <object id="29" template="../../../../common/maps/obj/dialog.tx" x="368" y="200">
   <properties>
    <property name="dialog">[
{
   "text": "Книга о жителях Шандалара, которые не владеют магией, и о том, как дать им место среди магов.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null, "action": [{"deleteMapObject":-1}]}]
}
]</property>
   </properties>
  </object>
  <object id="30" template="../../../../common/maps/obj/dialog.tx" x="80" y="200">
   <properties>
    <property name="dialog">[{"text":"Сверху детская книга про отряд гоблинов на воздушных шарах. Имена героям автор так и не придумал.","loctext":null,"options":[{"name":"Дальше","locname":null,"action":[{"deleteMapObject":-1},{"grantRewards":[{"type":"card","count":1,"cardName":"Dockside Extortionist|TLE"}]}]}]}]</property>
   </properties>
  </object>
  <object id="31" template="../../../../common/maps/obj/dialog.tx" x="144" y="200">
   <properties>
    <property name="dialog">[
{
   "text": "Родословные и списки жителей покрыты пылью. Видно, что одну книгу недавно брали в руки.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null, "action": [{"deleteMapObject":-1}]}]
}
]</property>
   </properties>
  </object>
  <object id="32" template="../../../../common/maps/obj/dialog.tx" x="176" y="200">
   <properties>
    <property name="dialog">[{"text":"В книге по биологии эльфов загнут угол страницы. Таких эльфов ты ещё не встречал в Шандаларе.","loctext":null,"options":[{"name":"Дальше","locname":null,"action":[{"deleteMapObject":-1},{"grantRewards":[{"type":"card","count":1,"cardName":"Turtle-Duck|TLA"}]}]}]}]</property>
   </properties>
  </object>
  <object id="34" template="../../../../common/maps/obj/dialog.tx" x="400" y="64">
   <properties>
    <property name="dialog">[
{
   "text": "Хроника набега на побережье. Рыбаки рассказывают, что нападавшие вышли прямо из моря.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null, "action": [{"deleteMapObject":-1}]}]
}
]</property>
   </properties>
  </object>
  <object id="35" template="../../../../common/maps/obj/dialog.tx" x="112" y="64">
   <properties>
    <property name="dialog">[
{
   "text": "Труды об осколках маны: почему они наполняются под землёй и как выглядел бы кристалл величиной с дом.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null, "action": [{"deleteMapObject":-1}]}]
}
]</property>
   </properties>
  </object>
  <object id="36" template="../../../../common/maps/obj/dialog.tx" x="96" y="240">
   <properties>
    <property name="dialog">[
{
   "text": "«Цена магии». Автор подсчитывает, чем обходится заклинателю каждый приём. Судя по пыли, книгу берут нечасто.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null, "action": [{"deleteMapObject":-1}]}]
}
]</property>
   </properties>
  </object>
  <object id="38" template="../../../../common/maps/obj/dialog.tx" x="352" y="240">
   <properties>
    <property name="dialog">[
{
   "text": "«Пропавшая рысь». Автор сравнивает повадки домашних кошек и леонинцев. Кто-то исцарапал обложку.",
   "loctext": null,
   "options": [{
      "name": "Дальше",
      "locname": null, "action": [{"deleteMapObject":-1}]}]
}
]</property>
   </properties>
